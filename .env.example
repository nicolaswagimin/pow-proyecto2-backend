# Copia este archivo como .env y rellena los valores. NUNCA subas el .env a GitHub.

# Puerto donde escucha el servidor (Render lo asigna solo; en local: 3002).
PORT=3002

# Cadena de conexión de PostgreSQL (Neon o Supabase → "Connection string").
DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_bd

# SSL para la conexión a la BD. Déjalo en true para Neon/Supabase; pon false para un PostgreSQL local.
DB_SSL=true

# API key de Google Gemini (https://aistudio.google.com/apikey). Solo vive en el backend.
GEMINI_API_KEY=

# Modelo de Gemini a usar. Si lo dejas vacío se usa gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Orígenes del frontend permitidos por CORS, separados por comas (sin "/" final).
# Ejemplo en producción: http://localhost:4200,https://mi-proyecto.vercel.app
FRONTEND_URL=http://localhost:4200
